# Plantilla de variables para desarrollo local.
# Copiar a un archivo .env local cuando se configure la infraestructura.
# Nunca guardar credenciales reales en este archivo.
# La API MoodleIntegration consume estos valores como Moodle__BaseUrl/Token.
MOODLE_BASE_URL=https://moodle.example.org
MOODLE_API_TOKEN=
# Configuración del proveedor JWT para MoodleIntegration.API.
IDENTITY_AUTHORITY=https://identity.example.org
IDENTITY_AUDIENCE=edumonitor-api
# Base de datos auxiliar
POSTGRES_DB=edumonitorai
POSTGRES_USER=edumonitor
POSTGRES_PASSWORD=
